{
  "name": "autodocbot-v2",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "start:prod": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "check:styleguide": "tsx src/article/styleguide-check.ts",
    "check:quality-review": "tsx src/article/quality-review-check.ts",
    "check:account-link": "tsx src/auth/account-link-check.ts",
    "test:mcp": "tsx src/mcp/test-client.ts",
    "check:token-store": "tsx src/auth/store-check.ts",
    "check:connection": "tsx src/auth/connection-check.ts",
    "check:security": "npm audit --omit=dev --audit-level=low",
    "check:diagram": "tsx src/diagram/process-svg-check.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^17.2.1",
    "jose": "^6.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
