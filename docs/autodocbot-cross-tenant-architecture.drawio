        </mxCell>
        <mxCell id="mcp" value="&lt;b&gt;Azure Container App&lt;/b&gt;&lt;br&gt;AutoDocBot V2 MCP&lt;br&gt;&lt;br&gt;JWT-Prüfung · ArticleSpec · Styleguide&lt;br&gt;Vorschau · SVG · Confluence-Publishing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2E8B70;strokeWidth=2;fontSize=13;fontColor=#164E3E;" vertex="1" parent="lab">
          <mxGeometry x="55" y="215" width="390" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="store" value="&lt;b&gt;Persistenter Azure File Share&lt;/b&gt;&lt;br&gt;verschlüsselte Atlassian-Verbindungen" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E8F7F1;strokeColor=#2E8B70;fontSize=12;fontColor=#164E3E;" vertex="1" parent="lab">
