          <mxGeometry x="270" y="410" width="175" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="atlassian" value="ATLASSIAN CLOUD" style="swimlane;startSize=42;rounded=1;fillColor=#E8F7F1;swimlaneFillColor=#F8FFFC;strokeColor=#2E8B70;strokeWidth=2;fontStyle=1;fontSize=15;fontColor=#164E3E;html=1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="120" width="450" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="oauth" value="&lt;b&gt;Atlassian OAuth 2.0 (3LO)&lt;/b&gt;&lt;br&gt;separate persönliche Zustimmung&lt;br&gt;Access- und Refresh-Token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#2E8B70;strokeWidth=2;fontSize=13;fontColor=#164E3E;" vertex="1" parent="atlassian">
          <mxGeometry x="50" y="90" width="350" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="confluence" value="&lt;b&gt;Confluence Cloud&lt;/b&gt;&lt;br&gt;festgelegte Dev-Site + Ziel-Space&lt;br&gt;&lt;br&gt;Seite im Storage Format&lt;br&gt;SVG als Attachment&lt;br&gt;Benutzer erscheint als Autor" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2E8B70;strokeWidth=2;fontSize=13;fontColor=#164E3E;" vertex="1" parent="atlassian">
          <mxGeometry x="65" y="285" width="320" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#4C78C2;strokeWidth=3;" edge="1" parent="1" source="user" target="teams"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#4C78C2;strokeWidth=3;" edge="1" parent="1" source="teams" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#845EC2;strokeWidth=3;" edge="1" parent="1" source="agent" target="connection"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#845EC2;strokeWidth=3;" edge="1" parent="1" source="connection" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#2E8B70;strokeWidth=3;" edge="1" parent="1" source="mcp" target="oauth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#2E8B70;strokeWidth=3;" edge="1" parent="1" source="mcp" target="confluence"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#2E8B70;strokeWidth=2;" edge="1" parent="1" source="mcp" target="store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#D6A33B;strokeWidth=2;" edge="1" parent="1" source="mcp" target="memory"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="step1" value="1" style="ellipse;html=1;fillColor=#4C78C2;strokeColor=#2F65A7;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="155" y="235" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="step2" value="2" style="ellipse;html=1;fillColor=#845EC2;strokeColor=#65469B;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="615" y="420" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="step3" value="3" style="ellipse;html=1;fillColor=#2E8B70;strokeColor=#22705A;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1215" y="280" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="step4" value="4" style="ellipse;html=1;fillColor=#2E8B70;strokeColor=#22705A;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1215" y="485" width="30" height="30" as="geometry"/></mxCell>

        <mxCell id="flow" value="&lt;b&gt;Hauptfluss&lt;/b&gt;   1  Standard-Tenant: Chat und Agent   →   2  Lab-Tenant: authentifizierter MCP-Aufruf   →   3  separate Atlassian-Zustimmung   →   4  Veröffentlichung im festgelegten Confluence-Space" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3BAC5;fontSize=13;fontColor=#172B4D;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="190" y="725" width="1520" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="boundary" value="&lt;b&gt;PoC-Besonderheit:&lt;/b&gt; Der Chat läuft im Standard-Tenant. Für die Power-Platform-Verbindung muss der Benutzer zusätzlich im Lab-Tenant authentifizierbar sein. Die Atlassian-Autorisierung ist davon vollständig getrennt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D6A33B;strokeWidth=2;fontSize=13;fontColor=#5B4200;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="190" y="825" width="1520" height="75" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="microsoft-flow" name="2 - Microsoft Cross-Tenant">
    <mxGraphModel dx="1800" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1050" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Microsoft-Cross-Tenant-Authentifizierung – aktueller PoC" style="text;html=1;align=left;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Jede Nachricht liegt in einer eigenen horizontalen Zeile. Die gestrichelten Linien zeigen nur die Lebensdauer der beteiligten Komponenten." style="text;html=1;align=left;whiteSpace=wrap;fontSize=13;fontColor=#44546F;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1700" height="30" as="geometry"/></mxCell>

        <mxCell id="p1" value="&lt;b&gt;Testuser&lt;/b&gt;&lt;br&gt;Standard + Lab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C78C2;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="110" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="p2" value="&lt;b&gt;Teams / Copilot&lt;/b&gt;&lt;br&gt;Standard-Tenant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBFF;strokeColor=#4C78C2;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="325" y="110" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="p3" value="&lt;b&gt;Power-Platform-Verbindung&lt;/b&gt;&lt;br&gt;Standard-Umgebung" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2E9FF;strokeColor=#845EC2;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="615" y="110" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="p4" value="&lt;b&gt;Connector-/Client-App&lt;/b&gt;&lt;br&gt;Lab Entra ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2E9FF;strokeColor=#845EC2;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="945" y="110" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="p5" value="&lt;b&gt;AutoDocBot API-App&lt;/b&gt;&lt;br&gt;Audience + Scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2E9FF;strokeColor=#845EC2;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1245" y="110" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="p6" value="&lt;b&gt;MCP-Server&lt;/b&gt;&lt;br&gt;Azure im Lab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2E8B70;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1545" y="110" width="190" height="70" as="geometry"/></mxCell>

        <mxCell id="l1" style="dashed=1;endArrow=none;strokeColor=#B3BAC5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="180" as="sourcePoint"/><mxPoint x="145" y="900" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l2" style="dashed=1;endArrow=none;strokeColor=#B3BAC5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="425" y="180" as="sourcePoint"/><mxPoint x="425" y="900" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l3" style="dashed=1;endArrow=none;strokeColor=#B3BAC5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="180" as="sourcePoint"/><mxPoint x="730" y="900" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l4" style="dashed=1;endArrow=none;strokeColor=#B3BAC5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="180" as="sourcePoint"/><mxPoint x="1050" y="900" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l5" style="dashed=1;endArrow=none;strokeColor=#B3BAC5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="180" as="sourcePoint"/><mxPoint x="1350" y="900" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l6" style="dashed=1;endArrow=none;strokeColor=#B3BAC5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1640" y="180" as="sourcePoint"/><mxPoint x="1640" y="900" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t1" value="1  Benutzer öffnet den persönlichen Agenten-Chat mit seinem Standard-Tenant-Konto" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="155" y="205" width="380" height="30" as="geometry"/></mxCell>
        <mxCell id="m1" style="endArrow=classic;html=1;strokeColor=#4C78C2;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="245" as="sourcePoint"/><mxPoint x="425" y="245" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t2" value="2  Der erste MCP-Toolaufruf benötigt eine persönliche Verbindung" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#3D245C;" vertex="1" parent="1"><mxGeometry x="440" y="305" width="320" height="30" as="geometry"/></mxCell>
        <mxCell id="m2" style="endArrow=classic;html=1;strokeColor=#845EC2;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="425" y="345" as="sourcePoint"/><mxPoint x="730" y="345" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t3" value="3  Verbindungsmanager startet die interaktive Anmeldung im Lab-Tenant" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#3D245C;" vertex="1" parent="1"><mxGeometry x="700" y="405" width="390" height="30" as="geometry"/></mxCell>
        <mxCell id="m3" style="endArrow=classic;html=1;strokeColor=#845EC2;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="445" as="sourcePoint"/><mxPoint x="1050" y="445" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t4" value="4  Lab Entra ID stellt ein delegiertes Access Token für access_as_user aus" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#3D245C;" vertex="1" parent="1"><mxGeometry x="1040" y="505" width="360" height="30" as="geometry"/></mxCell>
        <mxCell id="m4" style="endArrow=classic;html=1;strokeColor=#845EC2;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="545" as="sourcePoint"/><mxPoint x="1350" y="545" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t5" value="5  Die Verbindung sendet POST /mcp mit dem Bearer Access Token" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#3D245C;" vertex="1" parent="1"><mxGeometry x="900" y="605" width="560" height="30" as="geometry"/></mxCell>
        <mxCell id="m5" style="endArrow=classic;html=1;strokeColor=#845EC2;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="645" as="sourcePoint"/><mxPoint x="1640" y="645" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t6" value="6  Der MCP-Server prüft Signatur, Issuer, Audience, Tenant, Benutzer, Scope und erlaubten Client" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#164E3E;" vertex="1" parent="1"><mxGeometry x="1310" y="705" width="410" height="45" as="geometry"/></mxCell>
        <mxCell id="m6" style="endArrow=classic;html=1;strokeColor=#2E8B70;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="765" as="sourcePoint"/><mxPoint x="1640" y="765" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t7" value="7  Erst nach erfolgreicher Prüfung wird das MCP-Tool ausgeführt und die Antwort zurückgegeben" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#164E3E;" vertex="1" parent="1"><mxGeometry x="870" y="815" width="610" height="30" as="geometry"/></mxCell>
        <mxCell id="m7" style="endArrow=classic;html=1;strokeColor=#2E8B70;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1640" y="855" as="sourcePoint"/><mxPoint x="730" y="855" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="note" value="&lt;b&gt;Warum aktuell eine Zusatzanmeldung erscheint:&lt;/b&gt; Agent/Chat und MCP-API liegen nicht im selben Tenant. Der vorbereitete OBO-Connector ist noch nicht aktiv; daher wird die persönliche Power-Platform-Verbindung beim ersten Einsatz manuell hergestellt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D6A33B;strokeWidth=2;fontSize=13;fontColor=#5B4200;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="930" width="1360" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="atlassian-flow" name="3 - Atlassian und Publishing">
    <mxGraphModel dx="1800" dy="1280" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Atlassian-Autorisierung, Vorschau und Veröffentlichung" style="text;html=1;align=left;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Dieser Ablauf beginnt erst, nachdem die Microsoft-seitige MCP-Verbindung aus Seite 2 funktioniert." style="text;html=1;align=left;whiteSpace=wrap;fontSize=13;fontColor=#44546F;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1700" height="30" as="geometry"/></mxCell>

        <mxCell id="p1" value="&lt;b&gt;Testuser&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C78C2;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="110" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="p2" value="&lt;b&gt;Copilot-Agent&lt;/b&gt;&lt;br&gt;Standard-Tenant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBFF;strokeColor=#4C78C2;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="335" y="110" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="p3" value="&lt;b&gt;AutoDocBot MCP&lt;/b&gt;&lt;br&gt;Lab-Tenant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2E8B70;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="645" y="110" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="p4" value="&lt;b&gt;Atlassian OAuth 3LO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#2E8B70;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="955" y="110" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="p5" value="&lt;b&gt;Confluence API&lt;/b&gt;&lt;br&gt;Site + Ziel-Space" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#2E8B70;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1275" y="110" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="p6" value="&lt;b&gt;Token Store&lt;/b&gt;&lt;br&gt;Azure File Share" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E8F7F1;strokeColor=#2E8B70;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1575" y="100" width="170" height="80" as="geometry"/></mxCell>

        <mxCell id="l1" style="dashed=1;endArrow=none;strokeColor=#B3BAC5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="170" as="sourcePoint"/><mxPoint x="145" y="1200" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l2" style="dashed=1;endArrow=none;strokeColor=#B3BAC5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="170" as="sourcePoint"/><mxPoint x="435" y="1200" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l3" style="dashed=1;endArrow=none;strokeColor=#B3BAC5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="170" as="sourcePoint"/><mxPoint x="745" y="1200" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l4" style="dashed=1;endArrow=none;strokeColor=#B3BAC5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="170" as="sourcePoint"/><mxPoint x="1060" y="1200" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l5" style="dashed=1;endArrow=none;strokeColor=#B3BAC5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="170" as="sourcePoint"/><mxPoint x="1380" y="1200" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l6" style="dashed=1;endArrow=none;strokeColor=#B3BAC5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660" y="180" as="sourcePoint"/><mxPoint x="1660" y="1200" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t1" value="1  Agent prüft die benutzerbezogene Confluence-Verbindung" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#164E3E;" vertex="1" parent="1"><mxGeometry x="425" y="195" width="330" height="30" as="geometry"/></mxCell>
        <mxCell id="m1" style="endArrow=classic;strokeColor=#2E8B70;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="235" as="sourcePoint"/><mxPoint x="745" y="235" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t2" value="2  Falls nicht verbunden: MCP liefert einen einmaligen, zehn Minuten gültigen Link" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#164E3E;" vertex="1" parent="1"><mxGeometry x="430" y="275" width="500" height="30" as="geometry"/></mxCell>
        <mxCell id="m2" style="endArrow=classic;strokeColor=#2E8B70;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="315" as="sourcePoint"/><mxPoint x="435" y="315" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t3" value="3  Benutzer öffnet den Link und stimmt mit seinem eigenen Atlassian-Konto zu" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#164E3E;" vertex="1" parent="1"><mxGeometry x="240" y="355" width="600" height="30" as="geometry"/></mxCell>
        <mxCell id="m3" style="endArrow=classic;strokeColor=#2E8B70;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="395" as="sourcePoint"/><mxPoint x="1060" y="395" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t4" value="4  Atlassian sendet Authorization Code; MCP tauscht ihn gegen Benutzer-Tokens" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#164E3E;" vertex="1" parent="1"><mxGeometry x="720" y="435" width="500" height="30" as="geometry"/></mxCell>
        <mxCell id="m4" style="endArrow=classic;strokeColor=#2E8B70;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="475" as="sourcePoint"/><mxPoint x="745" y="475" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t5" value="5  Access-/Refresh-Token und Site-Daten werden je Microsoft-Benutzer verschlüsselt gespeichert" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#164E3E;" vertex="1" parent="1"><mxGeometry x="900" y="515" width="610" height="30" as="geometry"/></mxCell>
        <mxCell id="m5" style="endArrow=classic;strokeColor=#2E8B70;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="555" as="sourcePoint"/><mxPoint x="1660" y="555" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t6" value="6  Agent sendet konsolidierten Prozess, ArticleSpec und Qualitätsbericht" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="420" y="595" width="360" height="30" as="geometry"/></mxCell>
        <mxCell id="m6" style="endArrow=classic;strokeColor=#4C78C2;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="635" as="sourcePoint"/><mxPoint x="745" y="635" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t7" value="7  MCP validiert und liefert Vorschau-ID sowie vorbereitete Kartendaten" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="420" y="675" width="400" height="30" as="geometry"/></mxCell>
        <mxCell id="m7" style="endArrow=classic;strokeColor=#4C78C2;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="715" as="sourcePoint"/><mxPoint x="435" y="715" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t8" value="8  Benutzer bestätigt die konkrete aktuelle Vorschau per Adaptive Card" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#5B4200;" vertex="1" parent="1"><mxGeometry x="140" y="755" width="420" height="30" as="geometry"/></mxCell>
        <mxCell id="m8" style="endArrow=classic;strokeColor=#D6A33B;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="795" as="sourcePoint"/><mxPoint x="435" y="795" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t9" value="9  Nur bei gültiger Freigabe: publish_process_article(previewId, true)" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#5B4200;" vertex="1" parent="1"><mxGeometry x="420" y="835" width="390" height="30" as="geometry"/></mxCell>
        <mxCell id="m9" style="endArrow=classic;strokeColor=#D6A33B;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="875" as="sourcePoint"/><mxPoint x="745" y="875" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t10" value="10  MCP erstellt Seite, lädt SVG hoch und aktualisiert die Seite" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#164E3E;" vertex="1" parent="1"><mxGeometry x="850" y="915" width="440" height="30" as="geometry"/></mxCell>
        <mxCell id="m10" style="endArrow=classic;strokeColor=#2E8B70;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="955" as="sourcePoint"/><mxPoint x="1380" y="955" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t11" value="11  Confluence gibt Seiten- und Autoreninformationen zurück" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#164E3E;" vertex="1" parent="1"><mxGeometry x="835" y="995" width="440" height="30" as="geometry"/></mxCell>
        <mxCell id="m11" style="endArrow=classic;strokeColor=#2E8B70;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="1035" as="sourcePoint"/><mxPoint x="745" y="1035" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="t12" value="12  Agent zeigt den Link zum veröffentlichten Artikel" style="text;html=1;align=center;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="200" y="1075" width="410" height="30" as="geometry"/></mxCell>
        <mxCell id="m12" style="endArrow=classic;strokeColor=#4C78C2;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="1115" as="sourcePoint"/><mxPoint x="145" y="1115" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="note" value="&lt;b&gt;Drei unabhängige Entscheidungen:&lt;/b&gt; Microsoft prüft den MCP-Zugriff · Atlassian erlaubt Confluence-Aufrufe im Namen des Benutzers · die Adaptive Card gibt genau eine aktuelle Vorschau zur Veröffentlichung frei." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D6A33B;strokeWidth=2;fontSize=13;fontColor=#5B4200;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="1190" width="1360" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
