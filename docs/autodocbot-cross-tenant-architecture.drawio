        <mxCell id="sso" value="SSO/OBO-Connector: vorbereitet, nicht aktiv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#87909E;strokeWidth=2;dashed=1;fontSize=12;fontColor=#626F86;" vertex="1" parent="standard">
