  <diagram id="overview" name="1 - Gesamtübersicht">
    <mxGraphModel dx="1800" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="AutoDocBot V2 – aktueller Cross-Tenant-Aufbau" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Seite 1 zeigt nur Systemgrenzen und Hauptfluss. Die einzelnen Authentifizierungsabläufe stehen auf den Folgeseiten." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#44546F;" vertex="1" parent="1">
