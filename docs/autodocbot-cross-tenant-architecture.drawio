        <mxCell id="agent" value="&lt;b&gt;Copilot-Studio-Agent&lt;/b&gt;&lt;br&gt;Orchestrierung + Agentenanweisungen&lt;br&gt;Adaptive Card zur Vorschaufreigabe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBFF;strokeColor=#2F65A7;strokeWidth=2;fontSize=13;fontColor=#172B4D;" vertex="1" parent="standard">
