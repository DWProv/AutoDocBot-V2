          <mxGeometry x="35" y="245" width="120" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="standard" value="PROVECTUS STANDARD-TENANT" style="swimlane;startSize=42;rounded=1;fillColor=#EAF2FF;swimlaneFillColor=#F7FAFF;strokeColor=#4C78C2;strokeWidth=2;fontStyle=1;fontSize=15;fontColor=#17365D;html=1;container=1;collapsible=0;" vertex="1" parent="1">
